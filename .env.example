# Resend transactional delivery. Leave empty until the sender and recipient are verified.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Optional public-origin override after an approved domain is configured.
# Defaults to https://swd-ajmot.vercel.app for canonical and sitemap URLs.
SITE_URL=

# Required for contact submissions in production. Used only for short-lived rate-limit counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostgreSQL connection settings. Set these locally before running Compose.
# For Neon, DATABASE_URL should use the pooled endpoint and DIRECT_URL the direct endpoint.
DATABASE_URL=
DIRECT_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Single-admin authentication. Keep these server-side; never use NEXT_PUBLIC_ prefixes.
BETTER_AUTH_SECRET=G4Gh4v5zXalbKEACjLOtuAAZKTvjfMlCt50go4LL7X8
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=ajmot123@

# Cloudinary signed image uploads for the authenticated CMS. The upload preset
# must be configured as SIGNED in Cloudinary with an 8 MB maximum and only
# jpg,jpeg,png,webp,avif allowed. The API secret stays server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Required for distributed production login rate limiting.
# The same Upstash Redis REST instance used for contact throttling can be reused.
