# Resend transactional delivery. Leave empty until the sender and recipient are verified.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Optional public-origin override after an approved domain is configured.
# Defaults to https://swd-ajmot.vercel.app for canonical and sitemap URLs.
SITE_URL=

# Required for contact submissions in production. Used only for short-lived rate-limit counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
