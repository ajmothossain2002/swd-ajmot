# Local development defaults. Copy to .env and change the local-only password before use.
POSTGRES_DB=portfolio_cms
POSTGRES_USER=portfolio_admin
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://portfolio_admin:local-only-change-me@localhost:5432/portfolio_cms?schema=public
DIRECT_URL=postgresql://portfolio_admin:local-only-change-me@localhost:5432/portfolio_cms?schema=public

# Render production database: configure these in Render's Environment settings,
# not in this local file. Use the Render Postgres Internal Database URL for both
# DATABASE_URL and DIRECT_URL; keep the web service and database in one region.

# Canonical public origin. For Render set to https://swd-ajmot.onrender.com.
# For local work it may stay blank (defaults to the Vercel URL).
SITE_URL=

# Resend transactional delivery. Leave blank until sender and recipient are verified.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Required in production for login and contact rate limiting. Uses short-lived counters only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Single-admin authentication. Never use NEXT_PUBLIC_ prefixes.
# Local: BETTER_AUTH_URL=http://localhost:3000
# Render: BETTER_AUTH_URL=https://swd-ajmot.onrender.com
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set privately only when explicitly running npm run admin:provision or admin:password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary signed image uploads for the authenticated CMS. The upload preset
# must be configured as SIGNED in Cloudinary with an 8 MB maximum and only
# jpg,jpeg,png,webp,avif allowed. The API secret stays server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Required for distributed production login rate limiting.
# The same Upstash Redis REST instance used for contact throttling can be reused.
